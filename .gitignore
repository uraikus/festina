vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Festina -- created automatically at runtime by any compiled program
# that declares a table (claude.md #29), including if you run one of
# examples/*.f from the repo root while trying things out manually.
festina.sqlite

# benchmark.md's build outputs -- benchmarks/run_benchmarks.py builds
# into a temp dir itself, so these only appear if a binary is compiled
# by hand directly into benchmarks/ (e.g. `bin/festina benchmarks/fib.f
# -o benchmarks/fib`).
benchmarks/hello
benchmarks/fib
benchmarks/loop_sum

# "Real compilation, minimal setup" stage 2 -- scripts/package_compiler.sh's
# PyInstaller build output (a large, machine-specific binary; not something
# to commit) and PyInstaller's own scratch directories.
/dist/
/build/
*.spec

# claude.md #105: the MonoGame benchmark's build output. The project
# file and Program.cs are checked in; bin/ and obj/ are restored and
# rebuilt by benchmarks/canvas/run_canvas_benchmark.py on first run.
benchmarks/canvas/monogame/bin/
benchmarks/canvas/monogame/obj/

# tests/stress/collections_churn.f's mkdir()/ls() exercise (claude.md
# #50) creates this in the repo root when scripts/leak_stress.sh is run
# from here -- runtime scratch output, not something to commit.
/stress_dir/
